# syntax=docker/dockerfile:1
# Imagen para el backend FastAPI (paquete odin.api) y el scraper CLI (comando `odin`).
# Mismo código Python, dos usos: ver docker-compose.yml (servicios "backend" y "scraper").
#
# 3.13 y no 3.12: requirements.lock (ver README.md#requirementslock) se generó
# con `uv pip compile --python-version 3.13`, así que sus hashes solo cubren
# ruedas cp313. Instalarlo con --require-hashes (ver más abajo) sobre un
# intérprete distinto no encuentra candidato válido y el build falla.
FROM python:3.13-slim

WORKDIR /app

# Sin bytecode cacheado (contenedor efímero, no aporta) y logs sin buffer
# (aparecen en `docker logs` al instante en vez de esperar a que el buffer
# de stdout se llene). HOME se define más abajo, recién antes del USER
# appuser: si se define acá arriba, pip (que todavía corre como root en los
# pasos de instalación) resolvería su cache por defecto a
# $HOME/.cache/pip en vez de /root/.cache/pip, que es donde apunta el
# --mount=type=cache de abajo — el cache dejaría de usarse y encima
# quedaría escrito dentro de la capa de la imagen.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# El modelo de spaCy va primero y en su propia capa: el cache de capas de
# Docker es en cascada (si una capa se invalida, todas las siguientes en el
# mismo stage se reconstruyen aunque su propia instrucción no cambie). Como
# requirements.lock cambia seguido, si esta capa fuera *después* de instalar
# requirements.lock, cada cambio ahí forzaría re-descargar los ~568MB del
# modelo también. Puesta antes, solo se re-descarga si cambia esta línea.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install https://github.com/explosion/spacy-models/releases/download/es_core_news_lg-3.8.0/es_core_news_lg-3.8.0-py3-none-any.whl

# psycopg2-binary trae libpq embebido; no hacen falta headers de compilación.
#
# requirements.lock (no requirements.txt): fija con hash las dependencias
# transitivas, para que esta capa instale exactamente lo mismo sin importar
# cuándo se construya la imagen — ver README.md#requirementslock.
# --require-hashes rechaza el build si el lock no trae hash para algo que
# haya que instalar (por ejemplo, si alguien lo edita a mano en vez de
# regenerarlo con uv).
#
# torch llega de rebote (pysentimiento -> transformers/accelerate -> torch).
# El lock se regenera con `--torch-backend cpu` (ver comando arriba en
# README.md#requirementslock), así que ya pinnea la build `2.13.0+cpu` en vez
# de la build con CUDA por defecto de PyPI (que arrastra nvidia-*/triton,
# ~4.5GB, sin ninguna GPU disponible en el contenedor). Esa build solo vive en
# el índice de PyTorch, no en PyPI — de ahí el --extra-index-url.
#
# Cache de capas + cache de BuildKit (--mount=type=cache): mientras
# requirements.lock no cambie, esta capa se reutiliza tal cual (no se
# descarga nada). Si cambia, pip solo baja los paquetes nuevos/actualizados
# porque el cache de pip persiste entre builds aunque la capa se invalide.
COPY requirements.lock .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --require-hashes \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.lock

# Instala el paquete local (src/odin/) sin sus dependencias — ya están
# resueltas por requirements.lock arriba. Esto registra `odin` en
# site-packages, así "uvicorn odin.api:app" y el script de consola "odin"
# funcionan sin importar el WORKDIR, en vez de depender de que uvicorn
# agregue el cwd a sys.path por su cuenta. requirements.txt viaja junto a
# pyproject.toml porque `dynamic = ["dependencies"]` lo lee para armar los
# metadatos del paquete (ver pyproject.toml) — sin él, setuptools construye
# el paquete igual pero declarándolo sin dependencias, silenciosamente.
COPY pyproject.toml requirements.txt .
COPY src/ src/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps .

# Usuario sin privilegios para correr la app: si el proceso se ve
# comprometido (RCE en alguna dependencia, etc.) no queda como root dentro
# del contenedor. El cache de huggingface/spaCy vive bajo su home (ver
# volumen hf_cache en docker-compose.yml, actualizado a esta misma ruta).
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser \
    && mkdir -p /home/appuser/.cache/huggingface \
    && chown -R appuser:appuser /home/appuser

ENV HOME=/home/appuser

COPY --chown=appuser:appuser . .

USER appuser

EXPOSE 8000

# Sin HEALTHCHECK acá a propósito: esta misma imagen sirve dos comandos
# distintos (servicio "backend" con uvicorn, servicio "scraper" con el
# comando `odin` como CLI de una sola corrida) y un test fijo a /api/health
# marcaría al scraper como "unhealthy" para siempre, porque ahí nunca hay
# nada escuchando en el puerto 8000. El healthcheck real vive en
# docker-compose.yml, donde sí se puede scopear al servicio "backend".
CMD ["uvicorn", "odin.api:app", "--host", "0.0.0.0", "--port", "8000"]
