# --- Entorno y secretos ---
.venv/
.env

# --- Python ---
__pycache__/
*.pyc
*.egg-info/

# --- Caches de herramientas (se regeneran solas) ---
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- Base de datos local y respaldos ---
# El esquema vive en alembic/ y la semilla en db/seed_aliases.py: la BD se
# reconstruye desde cero, no se versiona. Los patrones de respaldo cubren el
# hueco por el que se colaban los .bak con fecha (no terminan en .db).
*.db
*.sqlite3
*.bak-*
*-backup-*.sql
backups/

# --- Scratch local ---
temp/

# Carpetas de exportación sueltas que caen en docs/ al bajar/descomprimir la
# plantilla (macOS numera los duplicados: "export 4"). Lo único de valor ahí
# es el .docx, y ese ya está versionado en src/odin/exports/ como package-data
# (pyproject: odin = [..., "exports/*.docx"]).
docs/export/
docs/export */

# --- Frontend ---
frontend/node_modules/
frontend/dist/
/node_modules/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Graphify (grafo de conocimiento del codebase) ---
# Se versiona solo lo legible y estable: el reporte y las etiquetas de
# communities (~67 KB). El resto es salida regenerable (~9.5 MB: cache de AST
# y semantica, graph.html, graph.json) o estado propio de cada maquina
# (.graphify_root y .graphify_python guardan rutas absolutas, manifest.json
# guarda mtimes), que solo genera ruido y conflictos entre equipos.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
