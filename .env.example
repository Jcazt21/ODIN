# Copia este archivo a .env y ajusta los valores.

# --- Base de datos ---
# PostgreSQL (por defecto para desarrollo):
DATABASE_URL=postgresql+psycopg2://odin:odin@localhost:5432/odin

# --- Docker Compose (Postgres) ---
# Credenciales del contenedor "db". docker-compose.yml construye el
# DATABASE_URL del backend/scraper a partir de estas (apuntando a db:5432),
# así que no hace falta duplicarlo aquí para ese caso.
POSTGRES_USER=odin
POSTGRES_PASSWORD=odin
POSTGRES_DB=odin

# SQL Server (para el cliente). Requiere pyodbc + ODBC Driver 18:
# DATABASE_URL=mssql+pyodbc://usuario:clave@servidor:1433/odin?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Scraping ---
# Máximo de artículos a procesar por periódico en cada corrida (0 = sin límite)
MAX_ARTICLES_PER_SOURCE=25
# Segundos base para el backoff entre reintentos
REQUEST_DELAY=1.5
# Peticiones concurrentes por fuente (throttle de cortesía)
FETCH_WORKERS=4
# Reintentos ante errores de red antes de descartar una URL
FETCH_RETRIES=3
# User-Agent para identificarse
USER_AGENT=OdinNewsBot/1.0 (+contacto: jeancarlosazar@gmail.com)

# --- Analizador Gemini (opcional, solo si usas --analyzer gemini) ---
# API key de Google Gemini. Consíguela en https://aistudio.google.com/apikey
# GEMINI_API_KEY=tu_clave_aqui
