# Copia este archivo a .env y ajusta los valores.

# --- Base de datos ---
# PostgreSQL (por defecto para desarrollo):
DATABASE_URL=postgresql+psycopg2://odin:odin@localhost:5432/odin

# --- Docker Compose (Postgres) ---
# Credenciales del contenedor "db". docker-compose.yml construye el
# DATABASE_URL del backend/scraper a partir de estas (apuntando a db:5432),
# así que no hace falta duplicarlo aquí para ese caso.
POSTGRES_USER=odin
POSTGRES_PASSWORD=odin
POSTGRES_DB=odin

# SQL Server (para el cliente). Requiere pyodbc + ODBC Driver 18:
# DATABASE_URL=mssql+pyodbc://usuario:clave@servidor:1433/odin?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Scraping ---
# Máximo de artículos a procesar por periódico en cada corrida (0 = sin límite)
MAX_ARTICLES_PER_SOURCE=25
# Segundos base para el backoff entre reintentos
REQUEST_DELAY=1.5
# Peticiones concurrentes por fuente (throttle de cortesía)
FETCH_WORKERS=4
# Reintentos ante errores de red antes de descartar una URL
FETCH_RETRIES=3
# User-Agent para identificarse
USER_AGENT=OdinNewsBot/1.0 (+contacto: jeancarlosazar@gmail.com)
# Leer y respetar robots.txt de cada dominio. Apagar (0) SOLO para pruebas
# locales contra un servidor propio; en producción no es opcional.
ODIN_RESPECT_ROBOTS_TXT=1

# --- API: autenticación ---
# Usuario único de la aplicación (no hay registro; solo login).
ODIN_AUTH_USER=admin
# Hash de la contraseña. Genéralo con:  python scripts/hash_password.py
ODIN_AUTH_PASSWORD_HASH=
# Alternativa en claro, SOLO para desarrollo. Si ODIN_AUTH_PASSWORD_HASH está
# definida, esta se ignora. Sin ninguna de las dos, el login rechaza todo.
# ODIN_AUTH_PASSWORD=
# Clave para firmar los JWT. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin ella se usa una clave efímera y las sesiones mueren en cada reinicio.
ODIN_JWT_SECRET=
# Horas de vigencia de la sesión
ODIN_JWT_TTL_HOURS=12

# --- API: qué URLs se pueden analizar (anti-SSRF) ---
# Allowlist de dominios para POST /api/analyze; se aceptan sus subdominios.
# Cualquier otro dominio se rechaza con 400. Agregar un medio nuevo = agregarlo
# aquí (y escribir su scraper si se quiere en el rastreo masivo).
ODIN_ALLOWED_DOMAINS=listindiario.com,diariolibre.com,elnacional.com.do,hoy.com.do,elcaribe.com.do,almomento.net,eldia.com.do,n.com.do,acento.com.do
# Tope de la página descargada (bytes) y de la URL (caracteres)
ODIN_MAX_DOWNLOAD_BYTES=5242880
ODIN_MAX_URL_LENGTH=2048
# Redirecciones a seguir; cada salto se revalida contra la allowlist
ODIN_MAX_REDIRECTS=3
ODIN_FETCH_TIMEOUT=20

# --- API: CORS ---
# Orígenes permitidos, separados por coma. En Docker el frontend habla por nginx
# (mismo origen) y esto no se usa; en desarrollo es el servidor de Vite.
ODIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Motor de análisis (esto decide si pagas) ---
# "local"  = spaCy + pysentimiento, GRATIS. Por defecto.
# "gemini" = Google Gemini, DE PAGO: una llamada facturada por cada análisis.
# "groq"   = Groq, free tier (openai/gpt-oss-120b).
# "hybrid" = local para tema/keywords/sentimiento + Groq para entidades/encuadre.
# "groq+gemini" = Groq primero y Gemini SOLO como red de seguridad cuando Groq
#            falla (rate limit, JSON truncado, red). Gratis en el caso normal,
#            pero es el único valor que puede facturar sin pedirlo de frente.
#
# Se elige aquí y solo aquí. Tener GEMINI_API_KEY/GROQ_API_KEY configurada NO
# activa el modo de pago: la llave puede estar para el CLI o simplemente
# olvidada en el .env.
ODIN_ANALYZER=local

# Árbitro de entidades ambiguas: llamada EXTRA y facturada a Gemini cuando el
# motor local encuentra personas dudosas. Apagado por defecto. Solo tiene efecto
# con ODIN_ANALYZER=local: cualquier motor LLM (gemini, groq, hybrid,
# groq+gemini) ya excluye por prompt los nombres que solo bautizan un lugar, y
# repetir el chequeo sería pagar dos veces por la misma decisión.
ODIN_GEMINI_ARBITER=0

# --- Jobs de POST /api/analyze ---
# Reusar el resultado de una URL analizada hace poco y no guardada, en vez de
# volver a llamar al LLM (dos clics en "Analizar" = un solo análisis). 0 lo apaga.
ODIN_ANALYZE_REUSE_MINUTES=60
# A partir de cuántos minutos un job en `running` se da por colgado (el proceso
# se reinició a mitad): el barrido de arranque lo marca como fallido.
ODIN_ANALYZE_JOB_STALE_MINUTES=15
# Cada job terminado guarda el cuerpo completo del artículo; esto es a las
# cuántas horas se borran. 0 desactiva el borrado.
ODIN_ANALYZE_JOB_TTL_HOURS=48

# --- Analizador Gemini (solo si ODIN_ANALYZER=gemini/groq+gemini o
#     ODIN_GEMINI_ARBITER=1) ---
# API key de Google Gemini. Consíguela en https://aistudio.google.com/apikey
# GEMINI_API_KEY=tu_clave_aqui

# --- Analizador Groq (solo si ODIN_ANALYZER=groq, hybrid o groq+gemini) ---
# API key de Groq (free tier). Consíguela en https://console.groq.com/keys
# GROQ_API_KEY=tu_clave_aqui

# --- Observabilidad (ver observability.py y docs/RUNBOOK.md) ---
# Formato de logs: "console" (texto legible) en desarrollo, "json" en
# producción para que el agregador de logs lo parsee.
ODIN_LOG_FORMAT=console
ODIN_LOG_LEVEL=INFO
# Sentry es opt-in: sin DSN, sentry_sdk.init nunca se llama.
# ODIN_SENTRY_DSN=
ODIN_SENTRY_ENVIRONMENT=development
